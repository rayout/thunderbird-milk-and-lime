{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.3.0",
  "author": "rayout (Alexandr Shapovalov)",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "{cc82279d-63ff-4802-841b-5026940f9ed8}",
      "strict_min_version": "157.0",
      "strict_max_version": "157.*"
    }
  },
  "background": {
    "scripts": [
      "avatars.js",
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "https://icons.duckduckgo.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "experiment_apis": {
    "LimeCards": {
      "schema": "experiment/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "LimeCards"
          ]
        ],
        "script": "experiment/api.js"
      }
    }
  }
}
